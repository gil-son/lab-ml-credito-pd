# Saídas de execução local -- nunca versionadas (geradas por EDA, treino,
# qualidade de dados, comparação, inferência, monitoramento e smoke test).
artifacts/*
!artifacts/.gitkeep

# MLflow local (file store) usado em desenvolvimento/testes.
mlruns/
mlartifacts/

# Build do wheel (gerado pela pipeline, não versionado).
dist/
build/
*.egg-info/

# Aprovação/promoção/rollback simulados localmente durante desenvolvimento.
approval.json

# Ambiente virtual e caches de ferramentas.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Spark/Delta local (warehouse, metastore Derby, logs).
spark-warehouse/
metastore_db/
derby.log

# Segredos locais -- nunca versionar.
.env